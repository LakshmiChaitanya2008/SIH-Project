# --- AI LLM Configuration (Zero Cost ₹0 Stack) ---
# Primary LLM: Groq LPU (Llama 3.3 70B & Llama 3.1 8B)
# Get free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Fallback LLM & Embeddings: Google Gemini (Gemini 3.6 Flash & gemini-embedding-001)
# Get free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# AI Provider Preference: 'groq' | 'gemini'
AI_LLM_PROVIDER=groq

